{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-adapter.schema.json",
  "title": "Repository Adapter",
  "type": "object",
  "required": [
    "adapterId",
    "status",
    "repository",
    "product",
    "stack",
    "commands",
    "runtime",
    "realData",
    "protectedAreas",
    "git",
    "devices"
  ],
  "properties": {
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "superseded"
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "name",
        "baselineCommit"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "baselineCommit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "product": {
      "type": "object",
      "required": [
        "purpose",
        "users",
        "outcomes",
        "networkRequired"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "networkRequired": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "stack": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "runtime": {
      "type": "object"
    },
    "realData": {
      "type": "object",
      "required": [
        "available",
        "mockDataAllowed"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "mockDataAllowed": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "protectedAreas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "git": {
      "type": "object"
    },
    "devices": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}