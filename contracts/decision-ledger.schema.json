{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-ledger.schema.json",
  "title": "Design Decision Ledger",
  "type": "object",
  "required": ["ledgerVersion", "decisions"],
  "properties": {
    "ledgerVersion": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "problem", "alternatives", "selected", "approval"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": ["proposed", "approved", "rejected", "revised", "superseded"]
          },
          "problem": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object"
            }
          },
          "selected": {
            "type": ["string", "null"]
          },
          "approval": {
            "type": ["object", "null"],
            "properties": {
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
