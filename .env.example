# Application mode: development | test | production
NODE_ENV=development

# Server
PORT=3000
HOST=0.0.0.0
# PUBLIC_APP_URL is the URL users see (used for OIDC redirects, distinct from bind address)
PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (pgvector) connection
DATABASE_URL=postgresql://pia:pia-dev@localhost:5432/pia

# Redis connection
REDIS_URL=redis://localhost:6379

# OpenID Connect
# The local development stack does not include an external OIDC provider.
# This bypass is supported only in development and test; production rejects it.
# Unset it when testing against a real OIDC provider.
# PIA_ALLOW_DEV_AUTH_BYPASS=1
OIDC_ISSUER=http://localhost:8080/realms/pia
OIDC_CLIENT_ID=pia-local
# OIDC_CLIENT_SECRET=<your-oidc-client-secret>
# SESSION_SECRET=<random-64-char-hex>

# S3-compatible object storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=pia-local
# STORAGE_ACCESS_KEY_ID=<your-storage-access-key>
# STORAGE_SECRET_ACCESS_KEY=<your-storage-secret-key>

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# Embedding provider
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-v1
# EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=1.0
EMBEDDING_BATCH_SIZE=20

# Model gateway (LLM) provider
MODEL_PROVIDER=fake
MODEL_NAME=fake-v1
# MODEL_API_KEY=<your-model-api-key>
MODEL_MAX_TOKENS=4096
MODEL_TEMPERATURE=0.7
MODEL_TIMEOUT_MS=30000

# Observability (OpenTelemetry)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=pia-api
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
