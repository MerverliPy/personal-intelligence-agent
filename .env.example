# Application mode: development | test | production
NODE_ENV=development

# Server
PORT=3000
HOST=0.0.0.0
# PUBLIC_APP_URL is the URL users see (used for OIDC redirects, distinct from bind address)
PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (pgvector) connection
DATABASE_URL=postgresql://pia:pia-dev@localhost:5432/pia

# Redis connection
REDIS_URL=redis://localhost:6379

# OpenID Connect
OIDC_ISSUER=http://localhost:8080/realms/pia
OIDC_CLIENT_ID=pia-local
# OIDC_CLIENT_SECRET=<your-oidc-client-secret>
# SESSION_SECRET=<random-64-char-hex>

# S3-compatible object storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=pia-local
# STORAGE_ACCESS_KEY_ID=<your-storage-access-key>
# STORAGE_SECRET_ACCESS_KEY=<your-storage-secret-key>

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
